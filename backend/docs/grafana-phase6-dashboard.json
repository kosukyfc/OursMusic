{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "gnetId": null,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "hideFrom": { "tooltip": false, "viz": false, "legend": false } },
          "mappings": []
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 2,
      "options": {
        "legend": { "calcs": [], "displayMode": "list", "placement": "bottom" },
        "pieType": "donut"
      },
      "pluginVersion": "8.0.0",
      "targets": [
        {
          "expr": "phase6_feature_toggle_total",
          "legendFormat": "{{ feature_name }}",
          "refId": "A"
        }
      ],
      "type": "piechart",
      "title": "Phase 6 Feature Usage Distribution"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" }, "mappings": [] },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 3,
      "options": { "orientation": "auto", "reduceOptions": { "values": false, "calcs": ["lastNotNull"] } },
      "pluginVersion": "8.0.0",
      "targets": [
        {
          "expr": "sum(phase6_active_users_gauge)",
          "legendFormat": "Active Users",
          "refId": "A"
        }
      ],
      "type": "gauge",
      "title": "Active Phase 6 Users"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" } } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 4,
      "options": { "legend": { "calcs": [], "displayMode": "list" }, "tooltip": { "mode": "single" } },
      "pluginVersion": "8.0.0",
      "targets": [
        {
          "expr": "rate(phase6_feature_response_time_ms_bucket[5m])",
          "legendFormat": "{{ endpoint }}",
          "refId": "A"
        }
      ],
      "type": "timeseries",
      "title": "Feature Response Time (ms)"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" } } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "id": 5,
      "options": { "legend": { "calcs": [], "displayMode": "list" }, "tooltip": { "mode": "single" } },
      "pluginVersion": "8.0.0",
      "targets": [
        {
          "expr": "rate(phase6_voice_commands_total[5m])",
          "legendFormat": "{{ command_type }} - {{ success }}",
          "refId": "A"
        }
      ],
      "type": "timeseries",
      "title": "Voice Commands Rate (commands/sec)"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" } } },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "id": 6,
      "options": { "legend": { "calcs": ["max", "mean"] }, "tooltip": { "mode": "multi" } },
      "pluginVersion": "8.0.0",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(phase6_music_theory_analyze_duration_ms_bucket[5m]))",
          "legendFormat": "95th percentile",
          "refId": "A"
        }
      ],
      "type": "timeseries",
      "title": "Music Theory Analysis Latency (p95)"
    }
  ],
  "schemaVersion": 30,
  "style": "dark",
  "tags": ["phase6", "analytics", "music-streaming"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "",
  "title": "OursMusic Phase 6 - Advanced Audio Features",
  "uid": "phase6-dashboard",
  "version": 1
