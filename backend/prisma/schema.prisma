generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Plan {
  free
  premium
  family
}

enum StorageType {
  s3
  nas
  drive
}

enum DownloadStatus {
  pending
  ready
  expired
}

enum ActionType {
  play
  download
  skip
  like
  add_to_playlist
}

// ─── Models ──────────────────────────────────────────────────────────────────

model User {
  id             String      @id @default(uuid())
  email          String      @unique
  passwordHash   String      @map("password_hash")
  name           String?
  username       String?     @unique
  bio            String?
  avatarUrl      String?     @map("avatar_url")
  coverUrl       String?     @map("cover_url")
  isPrivate      Boolean     @default(false) @map("is_private")
  plan           Plan        @default(free)
  isAdmin        Boolean     @default(false) @map("is_admin")
  offlineEnabled Boolean     @default(false) @map("offline_enabled")
  storageType    StorageType @default(s3) @map("storage_type")
  googleAccessToken  String? @map("google_access_token")
  googleRefreshToken String? @map("google_refresh_token")
  premiumExpiresAt   DateTime? @map("premium_expires_at")
  flair              Json?     @default("{}")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  playlists      Playlist[]
  downloads      Download[]
  activityLogs   ActivityLog[]
  favorites      Favorite[]
  uploadedSongs  Song[]
  refreshTokens  RefreshToken[]
  passwordResets PasswordResetToken[]
  following      Follow[]    @relation("follower")
  followers      Follow[]    @relation("following")
  songLikes      SongLike[]
  songComments   SongComment[]
  familyOwned    FamilyGroup?    @relation("FamilyOwner")
  familyMemberships FamilyMember[] @relation("FamilyMemberships")

  @@map("users")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Follow {
  followerId  String   @map("follower_id")
  followingId String   @map("following_id")
  createdAt   DateTime @default(now()) @map("created_at")

  follower  User @relation("follower",  fields: [followerId],  references: [id], onDelete: Cascade)
  following User @relation("following", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
  @@map("follows")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Artist {
  id        String   @id @default(uuid())
  name      String
  imageUrl  String?  @map("image_url")
  createdAt DateTime @default(now()) @map("created_at")

  albums  Album[]
  genres  ArtistGenre[]

  @@map("artists")
}

model Album {
  id        String   @id @default(uuid())
  artistId  String   @map("artist_id")
  title     String
  coverUrl  String?  @map("cover_url")
  year      Int?
  createdAt DateTime @default(now()) @map("created_at")

  artist Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)
  songs  Song[]

  @@map("albums")
}

model Song {
  id          String      @id @default(uuid())
  albumId     String?     @map("album_id")
  title       String
  artist      String?
  albumName   String?     @map("album_name")
  coverUrl    String?     @map("cover_url")
  duration    Int
  bitrate     Int?
  storageType StorageType @map("storage_type")
  storagePath String      @map("storage_path")
  fileSize    BigInt?     @map("file_size")
  mimeType    String      @default("audio/mpeg") @map("mime_type")
  uploadedBy  String?     @map("uploaded_by")
  spotifyId   String?     @map("spotify_id")
  deezerId    String?     @map("deezer_id")
  popularity  Int?
  genre       String?
  available   Boolean     @default(true)
  previewUrl  String?     @map("preview_url")
  lyrics      String?
  lyricsSynced String?    @map("lyrics_synced")
  videoUrl    String?     @map("video_url")
  playCount   Int         @default(0) @map("play_count")
  beatTimestamps String?  @map("beat_timestamps")  // JSON array of beat times in ms
  waveformData   String?  @map("waveform_data")    // JSON array of 200 amplitude samples [0..1]
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  album         Album?          @relation(fields: [albumId], references: [id], onDelete: SetNull)
  uploader      User?           @relation(fields: [uploadedBy], references: [id], onDelete: SetNull)
  playlistSongs PlaylistSong[]
  downloads     Download[]
  activityLogs  ActivityLog[]
  favorites     Favorite[]
  likes         SongLike[]
  comments      SongComment[]
  genres        GenreSong[]

  @@index([storagePath])
  @@index([uploadedBy, createdAt(sort: Desc)])
  @@index([genre])
  @@index([artist])
  @@index([title])
  @@index([popularity(sort: Desc)])
  @@index([playCount(sort: Desc)])
  @@map("songs")
}

model Playlist {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  title     String
  coverUrl  String?  @map("cover_url")
  isPublic  Boolean  @default(false) @map("is_public")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  songs PlaylistSong[]

  @@index([userId])
  @@index([isPublic])
  @@index([userId, createdAt(sort: Desc)])
  @@map("playlists")
}

model PlaylistSong {
  playlistId String   @map("playlist_id")
  songId     String   @map("song_id")
  position   Int
  addedAt    DateTime @default(now()) @map("added_at")

  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  song     Song     @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@id([playlistId, songId])
  @@index([songId])
  @@map("playlist_songs")
}

model Download {
  id            String         @id @default(uuid())
  userId        String         @map("user_id")
  songId        String         @map("song_id")
  status        DownloadStatus @default(pending)
  expiresAt     DateTime       @map("expires_at")
  encryptedPath String?        @map("encrypted_path")
  createdAt     DateTime       @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  song Song @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@index([userId, status, expiresAt])
  @@map("downloads")
}

model ActivityLog {
  id        String     @id @default(uuid())
  userId    String     @map("user_id")
  songId    String?    @map("song_id")
  action    ActionType
  timestamp DateTime   @default(now())
  metadata  Json?

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  song Song? @relation(fields: [songId], references: [id], onDelete: SetNull)

  @@map("activity_logs")
}

model Favorite {
  userId    String   @map("user_id")
  songId    String   @map("song_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  song Song @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@id([userId, songId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("favorites")
}

model SongLike {
  userId    String   @map("user_id")
  songId    String   @map("song_id")
  type      LikeType @default(like)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  song Song @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@id([userId, songId])
  @@index([songId])
  @@map("song_likes")
}

model SongComment {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  songId    String   @map("song_id")
  text      String
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  song Song @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@index([songId, createdAt(sort: Desc)])
  @@map("song_comments")
}

enum LikeType {
  like
  dislike
}

// ─── Genre Support (Many-to-many) ───────────────────────────────────────────

model Genre {
  id          String      @id @default(uuid())
  name        String      @unique
  description String?
  coverUrl    String?     @map("cover_url")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  songs   GenreSong[]
  artists ArtistGenre[]

  @@map("genres")
}

model GenreSong {
  genreId String @map("genre_id")
  songId  String @map("song_id")

  genre Genre @relation(fields: [genreId], references: [id], onDelete: Cascade)
  song  Song  @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@id([genreId, songId])
  @@index([songId])
  @@map("genre_songs")
}

model ArtistGenre {
  genreId String @map("genre_id")
  artistId String @map("artist_id")

  genre  Genre  @relation(fields: [genreId], references: [id], onDelete: Cascade)
  artist Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@id([genreId, artistId])
  @@index([artistId])
  @@map("artist_genres")
}

// ─── Device Connect / Multi-room ─────────────────────────────────────────────

model Device {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  socketId   String   @map("socket_id")          // current WS connection
  name       String                               // "Chrome on Windows"
  type       DeviceType @default(browser)
  isMaster   Boolean  @default(false) @map("is_master")
  isActive   Boolean  @default(true)  @map("is_active")
  lastSeen   DateTime @default(now()) @map("last_seen")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("devices")
}

model PlaybackSession {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")            // room = userId
  songId      String?  @map("song_id")
  songUrl     String?  @map("song_url")
  isPlaying   Boolean  @default(false) @map("is_playing")
  positionMs  Int      @default(0)    @map("position_ms")
  startedAt   DateTime @default(now()) @map("started_at")
  updatedAt   DateTime @updatedAt     @map("updated_at")

  @@unique([userId])
  @@map("playback_sessions")
}

// ─── Lyrics (Karaokê Premium) ─────────────────────────────────────────────────

model LyricsPremium {
  id            String   @id @default(uuid())
  trackId       String   @unique @map("track_id")
  title         String
  artist        String
  content       Json                                      // LyricsData JSON
  source        String   @default("user")                // 'genius' | 'musixmatch' | 'user' | 'api'
  language      String   @default("pt-BR")
  hasWordSync   Boolean  @default(false) @map("has_word_sync")
  bpm           Int?
  albumArt      String?  @map("album_art")
  duration      Int                                       // in milliseconds
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([trackId])
  @@index([source])
  @@map("lyrics_premium")
}

enum DeviceType {
  browser
  mobile
  speaker
  tv
}

// ─── Family Group ─────────────────────────────────────────────────────────────

model FamilyGroup {
  id        String   @id @default(uuid())
  ownerId   String   @unique @map("owner_id")
  createdAt DateTime @default(now()) @map("created_at")

  owner   User              @relation("FamilyOwner",  fields: [ownerId],  references: [id], onDelete: Cascade)
  members FamilyMember[]

  @@map("family_groups")
}

model FamilyMember {
  id        String   @id @default(uuid())
  groupId   String   @map("group_id")
  userId    String   @map("user_id")
  joinedAt  DateTime @default(now()) @map("joined_at")

  group FamilyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User        @relation("FamilyMemberships", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
  @@map("family_members")
}

// ─── PHASE 6: Listening Heatmap ───────────────────────────────────────────────

model ListeningHeatmap {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  dayOfWeek Int      @map("day_of_week") // 0-6 (Mon-Sun)
  hour      Int      // 0-23
  count     Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, dayOfWeek, hour])
  @@index([userId])
  @@map("listening_heatmaps")
}

// ─── PHASE 6: Music Theory Analyzer ───────────────────────────────────────────

model MusicTheoryAnalysis {
  id          String   @id @default(uuid())
  songId      String   @map("song_id")
  bpm         Int      // 60-180
  key         String   // C, C#, D, etc
  scale       String   // Major, Minor
  energy      Float    // 0-1
  danceability Float   // 0-1
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([songId])
  @@index([songId])
  @@map("music_theory_analyses")
}

// ─── PHASE 6: Similar Artists ────────────────────────────────────────────────

model ArtistRelationship {
  id             String   @id @default(uuid())
  artistId       String   @map("artist_id")
  relatedArtistId String  @map("related_artist_id")
  similarity     Float    // 0-1 score
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([artistId, relatedArtistId])
  @@index([artistId])
  @@map("artist_relationships")
}

// ─── PHASE 6: Smart Queue ────────────────────────────────────────────────────

model ListeningHistory {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  songId    String   @map("song_id")
  playedAt  DateTime @default(now()) @map("played_at")
  duration  Int      // ms
  completed Boolean  @default(false)

  @@index([userId])
  @@index([playedAt])
  @@map("listening_histories")
}

model SmartQueueSuggestion {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  songId    String   @map("song_id")
  mood      String   // happy, sad, energetic, chill
  score     Float    // 0-1 relevance
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("smart_queue_suggestions")
}

// ─── PHASE 6: Setlist Persistence ────────────────────────────────────────────

model Setlist {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  songs SetlistSong[]

  @@index([userId])
  @@map("setlists")
}

model SetlistSong {
  id        String   @id @default(uuid())
  setlistId String   @map("setlist_id")
  songId    String   @map("song_id")
  order     Int
  addedAt   DateTime @default(now()) @map("added_at")

  setlist Setlist @relation(fields: [setlistId], references: [id], onDelete: Cascade)

  @@unique([setlistId, songId])
  @@index([setlistId])
  @@map("setlist_songs")
}

// ─── PHASE 6: User Preferences ───────────────────────────────────────────────

model UserPreferences {
  id              String   @id @default(uuid())
  userId          String   @unique @map("user_id")
  fontSize        Float    @default(16.0) @map("font_size")
  lineHeight      Float    @default(1.5) @map("line_height")
  letterSpacing   Float    @default(0.0) @map("letter_spacing")
  dyslexiaFont    Boolean  @default(false) @map("dyslexia_font")
  dyslexiaContrast Int     @default(0) @map("dyslexia_contrast") // 0-2
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("user_preferences")
}
