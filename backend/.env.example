# ── Banco de dados ────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/oursmusic

# ── Servidor ──────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development   # production | development

# ── JWT — gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=<min 64 chars hex>
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=<min 64 chars hex, diferente do JWT_SECRET>
JWT_REFRESH_EXPIRES_IN=7d

# ── Argon2id pepper — gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ARGON2_PEPPER=<min 32 chars hex>

# ── Admin secret — gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# OBRIGATÓRIO em produção. Envie como header X-Admin-Token em todas as requisições admin.
ADMIN_SECRET_HEADER=<base64url 48 bytes>

# ── AWS / Supabase Storage ────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=tracks
S3_ENDPOINT=
S3_PUBLIC_URL=

# ── Google OAuth2 ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://seudominio.com/auth/google/callback

# ── Email SMTP ────────────────────────────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM=OursMusic <noreply@oursmusic.app>

# ── Frontend ──────────────────────────────────────────────────────────────────
FRONTEND_URL=https://seudominio.com

# ── Paths locais (desenvolvimento apenas) ────────────────────────────────────
SANDBOX_DIR=/tmp/music-sandbox
FFMPEG_PATH=
NODE_PATH=

# ── Deploy ────────────────────────────────────────────────────────────────────
# Caminho raiz onde os arquivos do deploy serão extraídos
DEPLOY_ROOT_PATH=C:/xampp/htdocs/oursmusics
